{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llmate": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLMate",
      "options": {
        "apiKey": "env:LLMATE_API_KEY",
        "baseURL": "env:LLMATE_BASE_URL"
      },
      "models": {
